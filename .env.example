# =========================================================
# AUTH PAGE BUILDER - ENVIRONMENT VARIABLES TEMPLATE
# =========================================================

# Database Configuration (MySQL)
DB_HOST=zdotapps-devenviron.cvuouqwaej9d.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=internship
DB_USER=internship_user
DB_PASSWORD=

# JWT Secret for User Authentication & OTP Signing
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# Django / Node Server Ports
PORT=3000
DJANGO_PORT=8000

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api

# Email SMTP Configuration (for Real OTP & Password Reset)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_or_smtp_secret
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Auth Page Builder <no-reply@authbuilder.com>

# WhatsApp Provider Configuration (Optional / Extensible)
WHATSAPP_API_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

